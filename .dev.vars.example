# این فایل به دکمه‌ی «Deploy to Cloudflare» می‌گه دقیقاً چه Secretهایی رو، با چه توضیحی
# (توضیح کامل هر کدوم در package.json زیر "cloudflare"."bindings" هست)، موقع نصب از کاربر بپرسه.
#
# هر خط زیر عمداً بعد از "=" خالیه — نه یک مقدار نمونه/ساختگی — تا خطر جایگزین‌نشدنش
# با مقدار واقعی از بین بره (اگه یک توکن ساختگی اینجا می‌ذاشتیم، ممکن بود کسی همون رو
# بدون تغییر دیپلوی کنه و ربات بی‌سروصدا از کار بیفته). خودِ فرم دیپلوی Cloudflare
# از روی همین اسم‌ها یک کادر ورودی برای هرکدوم می‌سازه.
#
# برای نصب دستی (بدون دکمه)، همین مقادیر با دستور `wrangler secret put <NAME>` ست می‌شن.

# توکن ربات تلگرام — از @BotFather در تلگرام با دستور /newbot می‌گیرید.
TELEGRAM_BOT_TOKEN=

# Instagram App ID — از App Dashboard متا، بخش «API setup with Instagram login».
# راهنمای کامل ساختش: docs/facebook-app-setup.md
FACEBOOK_APP_ID=

# Instagram App Secret — از همون صفحه‌ی App Dashboard متا، کنار App ID.
FACEBOOK_APP_SECRET=

# شناسه‌ی عددی حساب تلگرام خودتون (نه یوزرنیم) — از @userinfobot در تلگرام می‌گیرید.
# فقط همین شناسه اجازه‌ی فرمان‌دادن به ربات رو داره؛ بقیه با پیام «این ربات خصوصیه» رد می‌شن.
ADMIN_TELEGRAM_ID=

# یک رشته‌ی دلخواه خودتون (مثلاً یک کلمه‌ی تصادفی). دقیقاً همین مقدار رو بعداً موقع ثبت
# وبهوک اینستاگرام در App Dashboard متا هم به‌عنوان Verify Token وارد می‌کنید.
IG_WEBHOOK_VERIFY_TOKEN=
